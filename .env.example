# Postgres (used by docker-compose.yml and db.py)
POSTGRES_USER=tracker
POSTGRES_PASSWORD=tracker
POSTGRES_DB=profession_tracker
POSTGRES_PORT=5432
DATABASE_URL=postgresql://tracker:tracker@localhost:5432/profession_tracker

# Gmail SMTP delivery for the daily digest.
# GMAIL_APP_PASSWORD requires 2FA enabled on the account:
# https://myaccount.google.com/apppasswords
GMAIL_ADDRESS=you@example.com
GMAIL_APP_PASSWORD=changeme
DIGEST_TO=you@example.com

# Identifies the crawler honestly to profession.hu's server logs.
CRAWLER_CONTACT_EMAIL=you@example.com

# Turn individual sources on/off without touching code. Unset or "true"
# means enabled (the default); "false" skips it — logged, not treated
# as a failure. Useful for isolating one source while debugging, or
# temporarily pausing a slow/heavy one (Radancy) without disabling
# everything else.
ENABLE_PROFESSION_HU=true
ENABLE_EIGHTFOLD=true
ENABLE_SUCCESSFACTORS=true
ENABLE_RADANCY=true
ENABLE_ASHBY=true
ENABLE_WORKDAY=true
ENABLE_ALGOLIA=true
ENABLE_AVATURE=true
ENABLE_ICIMS=true
ENABLE_PHENOM=true
ENABLE_EPAM=true

# Same idea, one level more granular: pause a single company within a
# multi-company source (e.g. just BlackRock, keep Citi running) without
# touching the ENABLE_RADANCY switch above. The var name is derived from
# the company's own "name" in its companies_*.yaml (uppercased, spaces/
# punctuation collapsed to "_"), so it's always ENABLE_<NAME LIKE THAT>.
# Same default: unset or "true" means enabled.

# Eightfold
ENABLE_MORGAN_STANLEY=true
ENABLE_ERICSSON=true
ENABLE_VODAFONE=true

# SuccessFactors
ENABLE_SAP=true
ENABLE_ONE_HUNGARY=true
ENABLE_HCLTECH=true

# Radancy
ENABLE_CITI=true
ENABLE_BLACKROCK=true

# Ashby
ENABLE_SEON=true

# Workday
ENABLE_CLOUDERA=true

# Algolia
ENABLE_MSCI=true

# Avature
ENABLE_SIEMENS=true

# iCIMS
ENABLE_ONE_IDENTITY=true

# Phenom
ENABLE_GE_HEALTHCARE=true

# EPAM: no separate line needed — its one company is also named "EPAM",
# so the ENABLE_EPAM switch above already covers it at the company level.
